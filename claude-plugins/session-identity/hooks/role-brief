#!/usr/bin/env bash
# SessionStart hook: hands a role's session its brief (roles/<role>.md) as
# context. It fires again after /clear, a resume and every compaction, so the
# brief is always in the conversation. Mods can't add to the system prompt:
# the built-in security guard passes prompt.compose over them.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
cd "$(jq -r '.cwd // empty')" 2>/dev/null || exit 0
role=$("$here/role-name") || exit 0
brief="$here/../roles/$role.md"
[ -r "$brief" ] || exit 0
jq -n --rawfile brief "$brief" '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: $brief}}'

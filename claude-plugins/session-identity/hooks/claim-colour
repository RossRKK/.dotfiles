#!/usr/bin/env bash
# Prints the prompt-bar colour of the claude process this runs under: the one it
# already claimed, or else the colour fewest live sessions hold, claimed for it.
# Fails when there is no claude above it.
#
# Each claim is $XDG_RUNTIME_DIR/claude-agents/<pid>.colour (fishmonger colours
# the session's tab from it too); its recorded start time tells a live claim
# from a dead one whose pid was reused.
set -euo pipefail

dir=${XDG_RUNTIME_DIR:-/tmp}/claude-agents
# Claude's /color names, most distinct first; orange last as it is Claude's own accent.
palette='["red","blue","green","yellow","purple","cyan","pink","orange"]'

main() {
  local agent
  agent=$(claude_pid)
  mkdir -p "$dir"
  # Under a lock so sessions started together don't pick the same colour.
  exec 9>"$dir/colours.lock"
  flock 9
  claimed "$agent" || claim "$agent"
}

# The colour <pid> holds a live claim to; fails when it holds none.
claimed() {
  [ "$(jq -r .pid_start "$dir/$1.colour" 2>/dev/null)" = "$(start_time "$1")" ] &&
    jq -er .colour "$dir/$1.colour"
}

claim() {
  local colour
  colour=$(live_colours | jq -rRn --argjson palette "$palette" '
    [inputs] as $live
    | $palette | to_entries
    | min_by([(.value as $c | $live | map(select(. == $c)) | length), .key])
    | .value')
  jq -nc --arg colour "$colour" --argjson pid_start "$(start_time "$1")" \
    '{colour: $colour, pid_start: $pid_start}' >"$dir/$1.colour.tmp"
  mv -f "$dir/$1.colour.tmp" "$dir/$1.colour"
  printf '%s\n' "$colour"
}

# Prints each live claim's colour, deleting the dead claims it passes.
live_colours() {
  local file pid
  for file in "$dir"/*.colour; do
    [ -e "$file" ] || continue
    pid=$(basename "$file" .colour)
    if [ "$(jq -r .pid_start "$file" 2>/dev/null)" = "$(start_time "$pid")" ]; then
      jq -r .colour "$file"
    else
      rm -f "$file"
    fi
  done
}

# The nearest claude process above this script; fails when there is none.
claude_pid() {
  local pid=$PPID line
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    # nix's binary is .claude-unwrapped, which comm truncates to 15 chars.
    case $(cat "/proc/$pid/comm" 2>/dev/null) in
    claude | .claude-unwrapp) echo "$pid" && return 0 ;;
    esac
    # ppid follows the state after the LAST ")", since comm may contain one.
    line=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    pid=$(printf '%s' "${line##*) }" | cut -d' ' -f2)
  done
  return 1
}

# starttime is field 22 of stat, i.e. the 20th after the parenthesised comm.
start_time() {
  local line
  line=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
  printf '%s' "${line##*) }" | cut -d' ' -f20
}

main

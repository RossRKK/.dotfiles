#!/usr/bin/env bash
# SessionStart hook: tells the session named big-cheese (claude-launch gives that
# name to terminal 1 of the main ionics checkout) to load the big-cheese skill.
# Every other session gets nothing.
set -euo pipefail

# if this session isn't the big cheese there is nothing to say
[ "$(jq -r '.session_title // empty')" = big-cheese ] || exit 0

jq -n '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext:
  "You are big-cheese, the Claude in terminal 1 of the main checkout. Invoke the big-cheese:big-cheese skill now, before anything else, and follow it."}}'

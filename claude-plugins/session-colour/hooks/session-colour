#!/usr/bin/env bash
# SessionStart hook for /clear, which resets the prompt-bar colour but keeps the
# process: re-sends /color with the colour claude-launch claimed for that process
# ($XDG_RUNTIME_DIR/claude-agents/<pid>.colour), so the prompt bar matches the
# tab fishmonger colours from the same claim. Sessions with no claim (started
# without the launcher) get nothing.
set -euo pipefail

dir=${XDG_RUNTIME_DIR:-/tmp}/claude-agents

main() {
  local agent colour
  agent=$(claude_pid) || exit 0
  colour=$(jq -er .colour "$dir/$agent.colour" 2>/dev/null) || exit 0
  jq -n --arg colour "$colour" \
    '{hookSpecificOutput: {hookEventName: "SessionStart", initialUserMessage: "/color \($colour)"}}'
}

# The nearest claude process above this hook; fails when there is none.
claude_pid() {
  local pid=$PPID line
  while [ "$pid" -gt 1 ] 2>/dev/null; do
    # nix's binary is .claude-unwrapped, which comm truncates to 15 chars.
    case $(cat "/proc/$pid/comm" 2>/dev/null) in
    claude | .claude-unwrapp) echo "$pid" && return 0 ;;
    esac
    # ppid follows the state after the LAST ")", since comm may contain one.
    line=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    pid=$(printf '%s' "${line##*) }" | cut -d' ' -f2)
  done
  return 1
}

main

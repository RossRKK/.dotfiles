#!/usr/bin/env bash
# Starts Claude with a name and the prompt-bar colour fewest live sessions use,
# so sessions are told apart at a glance and addressed by name (SendMessage).
#
#   claude-launch <claude> [args...]
#
# A session's name is derived from its id, so it is the same every time it is
# resumed and an old unnamed session gets one too; terminal 1 of a checkout with
# a standing role, or of a worktree, is named for the role or branch instead
# (role_name). A new session (a fork too) is given its id here; -c resumes this
# directory's newest conversation by id. Every launch is recoloured, since a
# saved colour may now belong to a live session.
# Any other arguments pass straight through: Claude takes only one opening
# prompt, and ours ("/color ...") would collide with the caller's.
#
# Each claim is $XDG_RUNTIME_DIR/claude-agents/<pid>.colour. exec keeps the pid,
# so <pid> is the Claude process; its recorded start time tells a live claim
# from a dead one whose pid was reused.
set -euo pipefail

claude=$1
shift
dir=${XDG_RUNTIME_DIR:-/tmp}/claude-agents
# Claude's /color names, most distinct first; orange last as it is Claude's own accent.
palette='["red","blue","green","yellow","purple","cyan","pink","orange"]'

main() {
  local plugins=() id= name=()
  # home-manager's wrapper puts these ahead of the caller's arguments.
  while [ "${1-}" = --plugin-dir ]; do
    plugins+=("$1" "$2")
    shift 2
  done
  case "$*" in
  -c | --continue) set -- $(newest_session_args) ;;
  esac
  case $(session_kind "$@") in
  new)
    id=$(uuidgen | tr '[:upper:]' '[:lower:]')
    set -- --session-id "$id" "$@"
    ;;
  resume) id=$2 ;;
  pick) ;;
  other) exec "$claude" "${plugins[@]}" "$@" ;;
  esac
  [ -z "$id" ] || name=(--name "$(name_for "$id")")
  mkdir -p "$dir"
  local colour
  colour=$(claim_colour)
  exec "$claude" "${plugins[@]}" "${name[@]}" "/color $colour" "$@"
}

# new (a fork too), resume <id>, pick (the resume picker), or other: arguments
# this launcher leaves alone.
session_kind() {
  case "$#:${1-}:${3-}" in
  0:: | 3:-r:--fork-session | 3:--resume:--fork-session) echo new ;;
  2:-r: | 2:--resume:) echo resume ;;
  1:-r: | 1:--resume:) echo pick ;;
  *) echo other ;;
  esac
}

# What -c means, by id: --resume the newest conversation Claude stored for this
# directory, or nothing (a new session) when there is none.
newest_session_args() {
  local project newest
  project=$(pwd -P | sed 's/[^A-Za-z0-9]/-/g')
  newest=$(ls -t "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$project"/*.jsonl 2>/dev/null | head -n 1 || true)
  [ -z "$newest" ] || printf -- '--resume %s\n' "$(basename "$newest" .jsonl)"
}

# A session's name: its role's, or else one derived from <id>.
name_for() {
  role_name || petname --lists small --seed $((16#$(printf '%s' "$1" | sha256sum | cut -c1-15)))
}

# Terminal 1 of these checkouts holds a standing role, under a fixed name other
# sessions can always address it by; terminal 1 of a worktree is named for its
# branch, so whoever opened the worktree knows who to hand work to
# (worktree-tab). Fails for any other session.
role_name() {
  [ "${WORKSPACE_TERMINAL-}" = 1 ] || return 1
  case $(pwd -P) in
  "$(realpath -m "$HOME/ionics")") echo big-cheese ;;
  "$(realpath -m "$HOME/.dotfiles")") echo dotty ;;
  *) worktree_branch_name ;;
  esac
}

# This linked worktree's branch as one name component (feat/x -> feat-x), as
# util/worktree.lua slugs it. Fails in a main checkout or on a detached HEAD.
worktree_branch_name() {
  local git_dir branch
  git_dir=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
  [ "$git_dir" != "$(git rev-parse --path-format=absolute --git-common-dir)" ] || return 1
  branch=$(git branch --show-current)
  [ -n "$branch" ] || return 1
  printf '%s\n' "${branch//\//-}"
}

# Under a lock so sessions started together don't pick the same colour.
claim_colour() {
  local colour
  exec 9>"$dir/colours.lock"
  flock 9
  colour=$(live_colours | jq -rRn --argjson palette "$palette" '
    [inputs] as $live
    | $palette | to_entries
    | min_by([(.value as $c | $live | map(select(. == $c)) | length), .key])
    | .value')
  jq -nc --arg colour "$colour" --argjson pid_start "$(start_time $$)" \
    '{colour: $colour, pid_start: $pid_start}' >"$dir/$$.colour.tmp"
  mv -f "$dir/$$.colour.tmp" "$dir/$$.colour"
  # Claude would inherit the lock and hold it for its whole life.
  exec 9>&-
  printf '%s\n' "$colour"
}

# Prints each live claim's colour, deleting the dead claims it passes.
live_colours() {
  local file pid
  for file in "$dir"/*.colour; do
    [ -e "$file" ] || continue
    pid=$(basename "$file" .colour)
    if [ "$(jq -r .pid_start "$file" 2>/dev/null)" = "$(start_time "$pid")" ]; then
      jq -r .colour "$file"
    else
      rm -f "$file"
    fi
  done
}

# starttime is field 22 of stat, i.e. the 20th after the parenthesised comm.
start_time() {
  local line
  line=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
  printf '%s' "${line##*) }" | cut -d' ' -f20
}

main "$@"

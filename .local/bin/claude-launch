#!/usr/bin/env bash
# Starts Claude with a name and the prompt-bar colour fewest live sessions use,
# so sessions are told apart at a glance and addressed by name (SendMessage).
#
#   claude-launch <claude> [args...]
#
# A new session (a fork too) gets a petname; a resumed one keeps the name it was
# saved with but is recoloured, since its saved colour may now be taken.
# Any other arguments pass straight through: Claude takes only one opening
# prompt, and ours ("/color ...") would collide with the caller's.
#
# Each claim is $XDG_RUNTIME_DIR/claude-agents/<pid>.colour. exec keeps the pid,
# so <pid> is the Claude process; its recorded start time tells a live claim
# from a dead one whose pid was reused.
set -euo pipefail

claude=$1
shift
dir=${XDG_RUNTIME_DIR:-/tmp}/claude-agents
# Claude's /color names, most distinct first; orange last as it is Claude's own accent.
palette='["red","blue","green","yellow","purple","cyan","pink","orange"]'

main() {
  local plugins=() name=()
  # home-manager's wrapper puts these ahead of the caller's arguments.
  while [ "${1-}" = --plugin-dir ]; do
    plugins+=("$1" "$2")
    shift 2
  done
  case $(session_kind "$@") in
  new) name=(--name "$(petname --lists small)") ;;
  resumed) ;;
  other) exec "$claude" "${plugins[@]}" "$@" ;;
  esac
  mkdir -p "$dir"
  local colour
  colour=$(claim_colour)
  exec "$claude" "${plugins[@]}" "${name[@]}" "/color $colour" "$@"
}

# new, resumed, or other: arguments this launcher leaves alone.
session_kind() {
  case "$#:${1-}:${3-}" in
  0::) echo new ;;
  1:-c: | 1:--continue: | [12]:-r: | [12]:--resume:) echo resumed ;;
  3:-r:--fork-session | 3:--resume:--fork-session) echo new ;;
  *) echo other ;;
  esac
}

# Under a lock so sessions started together don't pick the same colour.
claim_colour() {
  local colour
  exec 9>"$dir/colours.lock"
  flock 9
  colour=$(live_colours | jq -rRn --argjson palette "$palette" '
    [inputs] as $live
    | $palette | to_entries
    | min_by([(.value as $c | $live | map(select(. == $c)) | length), .key])
    | .value')
  jq -nc --arg colour "$colour" --argjson pid_start "$(start_time $$)" \
    '{colour: $colour, pid_start: $pid_start}' >"$dir/$$.colour.tmp"
  mv -f "$dir/$$.colour.tmp" "$dir/$$.colour"
  # Claude would inherit the lock and hold it for its whole life.
  exec 9>&-
  printf '%s\n' "$colour"
}

# Prints each live claim's colour, deleting the dead claims it passes.
live_colours() {
  local file pid
  for file in "$dir"/*.colour; do
    [ -e "$file" ] || continue
    pid=$(basename "$file" .colour)
    if [ "$(jq -r .pid_start "$file" 2>/dev/null)" = "$(start_time "$pid")" ]; then
      jq -r .colour "$file"
    else
      rm -f "$file"
    fi
  done
}

# starttime is field 22 of stat, i.e. the 20th after the parenthesised comm.
start_time() {
  local line
  line=$(cat "/proc/$1/stat" 2>/dev/null) || return 0
  printf '%s' "${line##*) }" | cut -d' ' -f20
}

main "$@"

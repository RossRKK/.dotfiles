#!/usr/bin/env bash
# Opens a file in the main editor window of the surrounding nvim (never over
# its terminal), at a line and column when given.
#
#   nvim-open <path>[:line[:col]]
#
# A relative path is taken from the caller's directory, not nvim's. The opening
# itself is config/windows.lua's open(), shared with the editor's own openers.
set -euo pipefail

main() {
  [ $# -eq 1 ] && [ -n "$1" ] || fail "usage: nvim-open <path>[:line[:col]]"
  [ -n "${NVIM-}" ] || fail "not inside nvim (\$NVIM is unset)"
  local args
  args=$(open_args "$1" "$PWD")
  local path
  path=$(jq -r '.[0]' <<<"$args")
  [ -f "$path" ] || fail "no such file: $path"
  nvim --server "$NVIM" --remote-expr \
    "luaeval(\"require('config.windows').open(_A[1], _A[2], _A[3]) or ''\", $args)" >/dev/null
}

# <ref> as the JSON array [absolute path, line?, col?] (also a vimscript list),
# relative paths resolved against <dir>.
open_args() {
  local ref=$1 line=null col=null
  if [[ $ref =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
    ref=${BASH_REMATCH[1]} line=${BASH_REMATCH[2]} col=${BASH_REMATCH[3]}
  elif [[ $ref =~ ^(.+):([0-9]+)$ ]]; then
    ref=${BASH_REMATCH[1]} line=${BASH_REMATCH[2]}
  fi
  [[ $ref = /* ]] || ref=$2/$ref
  # A missing line or column is left off rather than sent as null, which vimscript lacks.
  jq -nc --arg path "$ref" --argjson line "$line" --argjson col "$col" \
    '[$path, $line, $col] | until(length == 1 or last != null; .[:-1])'
}

fail() {
  printf 'nvim-open: %s\n' "$1" >&2
  exit 1
}

main "$@"

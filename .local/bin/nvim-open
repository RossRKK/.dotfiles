#!/usr/bin/env bash
# Opens a file in the main editor window of the surrounding nvim (never over
# its terminal), at a line and column when given.
#
#   nvim-open <path>[:line[:col]]
#
# Run by a Claude session (CLAUDE_CODE_SESSION_ID set) it is that agent's jump:
# fishmonger opens it at once unless I'm editing, else it waits in the agent's
# tour list. Prints "opened" or "waiting".
#
# A relative path is taken from the caller's directory, not nvim's. The opening
# itself is config/windows.lua's open(), shared with the editor's own openers.
set -euo pipefail

main() {
  [ $# -eq 1 ] && [ -n "$1" ] || fail "usage: nvim-open <path>[:line[:col]]"
  [ -n "${NVIM-}" ] || fail "not inside nvim (\$NVIM is unset)"
  local place
  place=$(parse_place "$1" "$PWD" "${CLAUDE_CODE_SESSION_ID-}")
  [ -f "$(jq -r .path <<<"$place")" ] || fail "no such file: $(jq -r .path <<<"$place")"
  local outcome
  outcome=$(nvim --server "$NVIM" --remote-expr "luaeval(\"$(opener "$place")\", $place)")
  case $outcome in
    opened | waiting) echo "$outcome" ;;
    *) fail "$outcome" ;;
  esac
}

# The Lua that opens `place`: an agent's jump when it names a session, else a plain open.
opener() {
  if jq -e 'has("session")' <<<"$1" >/dev/null; then
    echo "require('fishmonger.tour').jump(_A)"
  else
    echo "require('config.windows').open(_A.path, _A.line, _A.col) or 'opened'"
  fi
}

# <ref> as the JSON object {path, line?, col?, session?} (also a vimscript dict),
# relative paths resolved against <dir>, the session given when not empty.
parse_place() {
  local ref=$1 line=null col=null
  if [[ $ref =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
    ref=${BASH_REMATCH[1]} line=${BASH_REMATCH[2]} col=${BASH_REMATCH[3]}
  elif [[ $ref =~ ^(.+):([0-9]+)$ ]]; then
    ref=${BASH_REMATCH[1]} line=${BASH_REMATCH[2]}
  fi
  [[ $ref = /* ]] || ref=$2/$ref
  # Absent keys are left off rather than sent as null, which vimscript lacks.
  jq -nc --arg path "$ref" --argjson line "$line" --argjson col "$col" --arg session "$3" \
    '{path: $path, line: $line, col: $col, session: (if $session == "" then null else $session end)}
      | with_entries(select(.value != null))'
}

fail() {
  printf 'nvim-open: %s\n' "$1" >&2
  exit 1
}

main "$@"

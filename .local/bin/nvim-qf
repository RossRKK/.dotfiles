#!/usr/bin/env python3
"""Sets and reads the quickfix list of the surrounding nvim (config/quickfix.lua).

  nvim-qf set <title>   entries on stdin, one `path:line[:col]: note` per line,
                        become the current list, docked under the main window
  nvim-qf state         the current list and where I am in it, as JSON (null
                        when it is empty)

A relative path is taken from the caller's directory, not nvim's.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ENTRY = re.compile(r"^(?P<path>.+?):(?P<line>\d+)(?::(?P<col>\d+))?:\s?(?P<text>.*)$")


class Refused(Exception):
    pass


def main() -> int:
    args = parse_args()
    server = os.environ.get("NVIM")
    try:
        if not server:
            raise Refused("not inside nvim ($NVIM is unset)")
        if args.command == "set":
            entries = parse_entries(sys.stdin.read().splitlines(), Path.cwd())
            remote_expr(
                server,
                lua_call(
                    "set(_A.title, _A.entries)",
                    {"title": args.title, "entries": entries},
                ),
            )
        else:
            print(
                remote_expr(
                    server,
                    "json_encode(luaeval('require(\"config.quickfix\").state()'))",
                )
            )
    except Refused as refusal:
        print(f"nvim-qf: {refusal}", file=sys.stderr)
        return 1
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="nvim-qf",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser(
        "set", help="make stdin's entries the current list"
    ).add_argument("title")
    commands.add_parser("state", help="print the current list as JSON")
    return parser.parse_args()


def parse_entries(lines: list[str], cwd: Path) -> list[dict]:
    """The `path:line[:col]: note` lines as entries, paths made absolute against `cwd`; blank lines skipped."""
    entries = []
    for number, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        match = ENTRY.match(line)
        if not match:
            raise Refused(f"line {number} is not `path:line[:col]: note`: {line}")
        path = cwd / match["path"]
        if not path.is_file():
            raise Refused(f"no such file: {path}")
        entry = {"path": str(path), "line": int(match["line"]), "text": match["text"]}
        if match["col"]:
            entry["col"] = int(match["col"])
        entries.append(entry)
    if not entries:
        raise Refused("no entries on stdin")
    return entries


def lua_call(call: str, argument: dict) -> str:
    """A vimscript expression calling config.quickfix's `call` with `argument` as `_A`."""
    # JSON in a single-quoted vimscript string, where the only escape is a doubled quote.
    payload = json.dumps(argument).replace("'", "''")
    return f"luaeval('require(\"config.quickfix\").{call}', json_decode('{payload}'))"


def remote_expr(server: str, expr: str) -> str:
    result = subprocess.run(
        ["nvim", "--server", server, "--remote-expr", expr],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise Refused(f"nvim refused: {result.stderr.strip()}")
    return result.stdout.strip()


if __name__ == "__main__":
    sys.exit(main())

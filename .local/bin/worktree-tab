#!/usr/bin/env bash
# Opens <branch>'s worktree as a tab of the surrounding nvim and prints the name
# of the Claude in its terminal 1 once that session can be sent messages, so an
# agent can hand it the work (SendMessage) instead of doing it here.
#
#   worktree-tab [--timeout <seconds>] <branch>
#
# The branch is resolved as the nvim picker resolves it (util/worktree.lua): an
# existing worktree is reused, a remote branch gets a local one, and any other
# name becomes a new branch off the main checkout's HEAD (in an nvim started with
# AGENT_WORKTREES=1, see there for where it lands). Run it from inside the
# repo. Waiting covers the checkout and Claude's start; the session is found in
# Claude's registry of running sessions by directory, the earliest started there
# being terminal 1's. nvim knows the name a new agent worktree's Claude is
# launched under, but the registry's is printed: a rename onto a taken name is
# suffixed.
set -euo pipefail

sessions=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions

main() {
  local timeout=600 opened agent path
  if [ "${1-}" = --timeout ]; then
    timeout=$2
    shift 2
  fi
  [ $# -eq 1 ] && [ -n "$1" ] || fail "usage: worktree-tab [--timeout <seconds>] <branch>"
  [ -n "${NVIM-}" ] || fail "not inside nvim (\$NVIM is unset)"

  opened=$(nvim --server "$NVIM" --remote-expr \
    "luaeval(\"require('util.worktree').open_for_agent(_A[1], _A[2])\", [$(json "$1"), $(json "$PWD")])")
  if ! path=$(jq -er .path <<<"$opened"); then
    fail "$(jq -r '.error // "nvim gave no answer"' <<<"$opened" 2>/dev/null || echo "$opened")"
  fi

  local deadline=$((SECONDS + timeout))
  until agent=$(first_live_session "$path"); do
    [ $SECONDS -lt $deadline ] || fail "no Claude started in $path within ${timeout}s"
    sleep 1
  done
  printf '%s\n' "$agent"
}

# The name of the earliest started running session in <dir> that has a
# messaging socket and its final name; fails when there is none. Claude
# registers a "derived" name at once and the session-identity mod's /rename
# lands after, so only a name the rename set ("collision" when it was taken) counts.
first_live_session() {
  local file dir
  dir=$(realpath -m "$1")
  for file in "$sessions"/*.json; do
    [ -e "$file" ] || continue
    jq -c --arg dir "$dir" \
      'select(.cwd == $dir and .messagingSocketPath != null and .name != null
              and (.nameSource == "user" or .nameSource == "collision"))
       | {pid, procStart, name, startedAt: (.startedAt // 0)}' "$file" 2>/dev/null || true
  done | while read -r entry; do
    if running "$(jq -r .pid <<<"$entry")" "$(jq -r .procStart <<<"$entry")"; then
      printf '%s\n' "$entry"
    fi
  done | jq -enr '[inputs] | min_by(.startedAt) | .name'
}

# Whether process <pid> is still the one that started at <start> (clock ticks
# since boot, /proc/<pid>/stat's 22nd field): a crashed session's file outlives
# it, and after a reboot its pid can belong to anything.
running() {
  local stat fields
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  # Fields count from after the command name, which may hold spaces and parens.
  read -ra fields <<<"${stat##*) }"
  [ "${fields[19]}" = "$2" ]
}

# <text> as a vimscript string literal (JSON's string syntax is a subset).
json() {
  jq -Rn --arg s "$1" '$s'
}

fail() {
  printf 'worktree-tab: %s\n' "$1" >&2
  exit 1
}

main "$@"

#!/usr/bin/env sh
# What to show where a git branch name would go, in a jj repo. Used by starship's
# [custom.jj] module (see ~/.config/starship.toml).
#
# jj has no current branch, and in a colocated repo git's HEAD is detached for
# any ordinary jj working state, so starship's git_branch renders a bare sha.
# The nearest bookmark at or under the working copy is the closest equivalent: a
# fresh change on top of `feat/x` carries no bookmark of its own but is still the
# work on feat/x. Failing that the description says more than the change id, and
# the id is the last resort.
#
# Mirrors triage.nvim's jj backend (lua/triage/vcs/jj.lua), which answers the
# same question for neovim's tab labels.
# --ignore-working-copy keeps a prompt render from taking the repo lock or
# snapshotting on every keystroke.

set -e

# Matches starship's [git_branch] truncation_length and util/jj.lua's, so a long
# name is cut at the same place in the prompt and in neovim's tab labels. Custom
# modules have no truncation_length of their own, hence doing it here.
trunc() { cut -c1-32; }

jj() { command jj --ignore-working-copy --color=never --no-pager "$@"; }

bookmark=$(jj log --no-graph -r 'latest(heads(::@ & bookmarks()), 1)' \
  -T 'bookmarks.join(",")' 2>/dev/null | cut -d, -f1)
if [ -n "$bookmark" ]; then
  printf '%s' "$bookmark" | trunc
  exit 0
fi

jj log --no-graph -r @ \
  -T 'coalesce(description.first_line(), change_id.shortest(8))' 2>/dev/null | trunc
